{
  "name": "splat-bvh-core",
  "version": "0.1.0",
  "description": "WebGPU-accelerated Linear Bounding Volume Hierarchy (LBVH) generator for interactive 3D Gaussian Splatting.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts",
    "dev": "tsup src/index.ts --format cjs,esm --dts --watch",
    "lint": "eslint src --ext .ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nff747/splat-bvh-core.git"
  },
  "keywords": [
    "webgpu",
    "gaussian-splatting",
    "bvh",
    "lbvh",
    "spatial-index",
    "raycasting",
    "physics",
    "3d",
    "morton-code"
  ],
  "author": "iKi <nff747@users.noreply.github.com>",
  "license": "MIT",
  "devDependencies": {
    "@webgpu/types": "^0.1.72",
    "tsup": "^8.3.0",
    "typescript": "^5.6.0",
    "vitest": "^4.1.11"
  }
}
